    {
        "id": "c9e9dafc376690a7",
        "type": "function",
        "z": "6c2f4babd388c156",
        "name": "Health Score",
        "func": "let data = msg.payload;\nlet score = 100;\n\nif (data.temperature > 55) {\n    score -= 20;\n}\n\nif (data.vibration > 3.5) {\n    score -= 25;\n}\n\nif (data.load > 75) {\n    score -= 15;\n}\n\nif (score < 0) {\n    score = 0;\n}\n\nmsg.payload = score;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
