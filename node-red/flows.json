    {
        "id": "538c01b6d398aaea",
        "type": "function",
        "z": "6c2f4babd388c156",
        "name": "Health Logic",
        "func": "let data = msg.payload;\n\nif (\n    data.temperature > 55 ||\n    data.vibration > 3.5 ||\n    data.load > 75\n) {\n    msg.payload = \"WARNING\";\n} else {\n    msg.payload = \"HEALTHY\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
