    {
        "id": "96356ec30a792afa",
        "type": "function",
        "z": "6c2f4babd388c156",
        "name": "Fault Reason",
        "func": "let data = msg.payload;\nlet problems = [];\n\nif (data.temperature > 55) {\n    problems.push(\"HIGH TEMPERATURE\");\n}\n\nif (data.vibration > 3.5) {\n    problems.push(\"HIGH VIBRATION\");\n}\n\nif (data.load > 75) {\n    problems.push(\"OVERLOAD\");\n}\n\nif (problems.length === 0) {\n    msg.payload = \"NONE\";\n} else {\n    msg.payload = problems.join(\" | \");\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
